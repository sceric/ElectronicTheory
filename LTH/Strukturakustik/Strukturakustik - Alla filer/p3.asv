n= 0:1:10;
a=0.6252;
b=3.1416;
g=complex(a,b);

f1=abs(exp(-g*n));
f2=angle(exp(-g*n));

subplot(2,2,1)
plot(n,f1,'r')
hold on
plot(n,f2,'g')

grid
xlabel('x---->')
ylabel('Fn (eller v)---->')
Title('Oändligt periodiskt fall för stoppband')
legend('g=0.6252+3.1416*i','fas');




a=0;
